package templates

import "github.com/MaratBR/openlibrary/internal/app"
import "github.com/MaratBR/openlibrary/internal/i18n"
import "fmt"
import "github.com/MaratBR/openlibrary/internal/olhttp"
import "github.com/MaratBR/openlibrary/internal/csrf"
import "github.com/MaratBR/openlibrary/internal/olhttp/webcomponents"

templ Library(wantToRead, reading, paused []app.BookLibraryDto) {
    {{
        l := i18n.GetLocalizer(ctx)
    }}

    @standardPageLayout(standardPageLayoutProps{
        htmlLayoutProps: htmlLayoutProps{
            Title: l.T("library.title"),
        },
    }) {
        <header class="LibraryHeader">
            <div class="OlContainer LibraryHeader-inner">
                <h1 class="LibraryHeader-title">{l.T("library.title")}</h1>
                <nav class="LibraryHeader-tabs" aria-label={l.T("library.title")}>
                    @libraryTab(l.T("library.title"), "/library", true)
                    @libraryTab(l.T("library.archive"), "/library/archive", false)
                    @libraryTab(l.T("library.collections"), "/library/collections", false)
                </nav>
            </div>
        </header>
        <main class="OlContainer">
            @webcomponents.Island2(webcomponents.Island2Props{
				Name: "book-card-preview",
				Data: map[string]string{"selector": ".library-body"},
			})
        
            <div class="library-body">
                if len(reading) + len(paused) + len(wantToRead) == 0 {
                    @alertInfo() {
                        {l.T("library.libraryDescription")}
                    }
                }

                if len(reading) != 0 {
                    @librarySection(l.T("readingList.reading"), reading)
                }
                if len(paused) != 0 {
                    @librarySection(l.T("readingList.paused"), paused)
                }
                if len(wantToRead) != 0 {
                    @librarySection(l.T("readingList.want_to_read"), wantToRead)
                }
            </div>
        </main>
    }
}

templ libraryTab(
    title, url string,
    active bool,
) {
    if active {
        <a href={templ.SafeURL(url)} aria-current="page" class="LibraryHeader-item LibraryHeaderItem--active">{title}</a>
    } else {
        <a href={templ.SafeURL(url)} class="LibraryHeader-item">{title}</a>
    }
}


templ librarySection(label string, books []app.BookLibraryDto) {
    <section class="LibrarySection">
        <header class="LibrarySection-header">
            <h2>{ label }</h2>
        </header>
        <div class="LibrarySection-books">
            for _, book := range books {
                @libraryBookCard(book.ID, book.Name, book.Cover)
            }
        </div>
    </section>
}

templ libraryBookCard(bookID int64, name string, cover app.BookCover) {

    @censoredContent(bookID) {
    <a 
        href={ templ.SafeURL(fmt.Sprintf("/book/%d?ol.from=library", bookID)) } 
        class="LibraryBook"
        data-book-card-preview={ fmt.Sprintf("%d", bookID) }>
        <div class="LibraryBook-cover"><img src={cover.URL} alt="" loading="lazy" width="200" height="300" /></div>
        <div class="LibraryBook-title">
            { name }
        </div>
    </a>

    }
}


templ LibraryArchive(read, dnf []app.BookLibraryDto) {
    {{
        l := i18n.GetLocalizer(ctx)
    }}

    @standardPageLayout(standardPageLayoutProps{
        htmlLayoutProps: htmlLayoutProps{
            Title: l.T("library.title"),
        },
    }) {
        <header class="LibraryHeader">
            <div class="OlContainer LibraryHeader-inner">
                <h1 class="LibraryHeader-title">{l.T("library.archive")}</h1>
                <nav class="LibraryHeader-tabs" aria-label={l.T("library.title")}>
                    @libraryTab(l.T("library.title"), "/library", false)
                    @libraryTab(l.T("library.archive"), "/library/archive", true)
                    @libraryTab(l.T("library.collections"), "/library/collections", false)
                </nav>
            </div>
        </header>


        <main class="OlContainer">
            @webcomponents.Island2(webcomponents.Island2Props{
				Name: "book-card-preview",
				Data: map[string]string{"selector": ".library-body"},
			})
        
            <div class="library-body">
                if len(read) + len(dnf) == 0 {
                    @alertInfo() {
                        {l.T("library.archiveDescription")}
                    }
                }

                if len(read) != 0 {
                    @librarySection(l.T("readingList.read"), read)
                }
                if len(dnf) != 0 {
                    @librarySection(l.T("readingList.dnf"), dnf)
                }
            </div>
        </main>
    }
}

templ LibraryCollections(result app.GetUserCollectionsResult, booksMap map[int64][]app.CollectionBookDto) {
    {{
        l := i18n.GetLocalizer(ctx)
    }}
        @standardPageLayout(standardPageLayoutProps{
        htmlLayoutProps: htmlLayoutProps{
            Title: l.T("library.title"),
        },
    }) {
        <header class="LibraryHeader">
            <div class="OlContainer LibraryHeader-inner">
                <h1 class="LibraryHeader-title">{l.T("library.collections")}</h1>
                <nav class="LibraryHeader-tabs" aria-label={l.T("library.title")}>
                    @libraryTab(l.T("library.title"), "/library", false)
                    @libraryTab(l.T("library.archive"), "/library/archive", false)
                    @libraryTab(l.T("library.collections"), "/library/collections", true)
                </nav>
            </div>
        </header>

        <main class="OlContainer">
            @webcomponents.Island2(webcomponents.Island2Props{
				Name: "book-card-preview",
				Data: map[string]string{"selector": ".library-body"},
			})

            {{
                pagination := olhttp.Pagination(uint32(result.Page), uint32(result.TotalPages), 6)
            }}
        
            <div class="library-body">
                <div x-data="{open:false,name:''}" class="mb-8">
                    <button 
                        x-show="!open" 
                        @click="open=true;$nextTick(()=>$refs.input.focus())" 
                        class="LibraryCreate">
                        <div class="LibraryCreate-icon">
                            <i class="fa-solid fa-plus"></i>
                        </div>

                        <span class="font-medium text-lg">
                            {l.T("collection.createCollection")}
                        </span>
                    </button>

                    <section class="bg-surface rounded-lg relative" x-cloak x-show="open">
                        <form method="post" class="m-2">
                            <label for="library-collection-name" class="block px-6 pt-4 font-medium">{l.T("collection.namePlaceholder")}</label>
                            @csrf.CSRFInputTempl(ctx)
                            <input 
                                id="library-collection-name"
                                x-model="name"
                                x-ref="input"
                                @blur="if (!$event.target.value) open=false" 
                                name="name" 
                                required 
                                maxlength="255"
                                class="w-full block text-3xl px-6 h-18 font-medium focus-visible:outline-2 focus-visible:outline-primary bg-transparent"
                                placeholder={l.T("collection.namePlaceholder")} />
                            <div x-collapse x-cloak x-show="name.trim().length>0">
                                <button type="submit" class="Btn Btn--outline Btn--lg my-4">
                                    {l.T("collection.createCollection")}
                                </button>
                            </div>
                        </form>
                    </section>
                </div>

                if result.TotalPages > 0 {
                    if result.TotalPages > 1 {
                        <div class="mb-2">
                            @pagination
                        </div>
                    }
                    @collectionsList(result.Collections, booksMap, true)
                    if result.TotalPages > 1 {
                        <div class="mt-2">
                            @pagination
                        </div>
                    }
                }
            </div>
        </main>
    }
}

templ collectionsList(collections []app.CollectionDto, booksMap map[int64][]app.CollectionBookDto, gallery bool) {
    <ul class={templ.KV("LibraryCollections", gallery), templ.KV("space-y-2", !gallery)}>
        for _, col := range collections {
            {{
                books, _ := booksMap[col.ID]
            }}
            @libraryCollectionCard(col, books, gallery)
        }
    </ul>
}

templ libraryCollectionCard(collection app.CollectionDto, books []app.CollectionBookDto, gallery bool) {
    <li class={"LibraryUserCollection", templ.KV("LibraryUserCollection--gallery", gallery)}>
        <a href={ templ.SafeURL(fmt.Sprintf("/col/%d", collection.ID)) } class="LibraryUserCollection-header">
            {{
                name := collection.Name
                if name == "" {
                    name = "NO_NAME"
                }
            }}
            <div class="LibraryUserCollection-name">{ name }</div>

            <div class="text-secondary-foreground">
                {{
                    l := i18n.GetLocalizer(ctx)
                }}
                { _tt(l, "collection.books", map[string]string{
                    "count": fmt.Sprintf("%d", collection.BooksCount),
                }) }
            </div>
        </a>

        if len(books) > 0 {
            <ul class="LibraryUserCollection-books">
                for _, book := range books {
                    <li>
                        @censoredContent(book.ID) {
                        <a href={ templ.SafeURL(fmt.Sprintf("/book/%d", book.ID)) }>
                            <img src={ book.Cover.URL } alt={book.Name} loading="lazy" width="100" height="150" />
                        </a>
                        }
                    </li>
                }
            </ul>
            }
    </li>
}