package templates

import "github.com/MaratBR/openlibrary/internal/app"
import "github.com/MaratBR/openlibrary/internal/i18n"
import "github.com/MaratBR/openlibrary/internal/commonutil"
import "fmt"
import "strconv"
import "github.com/MaratBR/openlibrary/internal/olhttp"
import "github.com/MaratBR/openlibrary/internal/olhttp/webcomponents"
import "github.com/MaratBR/openlibrary/internal/auth"
import "time"

type ChapterProgressTrackerOptions struct {
    JumpedBackward bool
    JumpedForward bool
    Enable bool
}

templ Chapter(
    chapter app.ChapterDto,
    book app.BookDetailsDto,
    options ChapterProgressTrackerOptions,
    preferences app.ReaderPreferences,
) {
    {{
        l := i18n.GetLocalizer(ctx)
        _, isAuthenticated := auth.GetSession(ctx)
    }}

    @htmlLayout(htmlLayoutProps{Title: chapter.Name}) {
        @olhttp.JSServerData("chapterId", fmt.Sprintf("%d", chapter.ID))

        @siteHeaderLayout() {
            <div class="h-full flex-nowrap overflow-x-auto whitespace-nowrap items-center flex gap-2">
                <a class="link !font-[600] hidden lg:block" href={ templ.SafeURL(fmt.Sprintf("/book/%d", book.ID)) }>
                    { book.Name }
                </a>
                <i class="fa-solid fa-arrow-right"></i>
                <span class="font-semibold">
                    { chapter.Name }
                </span>
            </div>
            <div class="mx-auto" />
        }

        <div
            x-data="BookReader"
            data-font-size={ strconv.Itoa(int(preferences.FontSize)) }
            data-font-family={ preferences.FontFamily }
            data-page-color={ preferences.PageColor }
            data-reader-theme={ preferences.Theme }
            if isAuthenticated {
                data-authenticated="true"
            }
            class="book-reader"
            @keydown.escape.window="settingsOpen = false">
            <div class="book-reader__reading-area">
                <button x-bind="toggleButton" class="book-reader__settings-button btn btn--icon btn--ghost" aria-label={ l.T("reader.settings") }>
                    <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                </button>
                <div class="book-reader__chapter">
                    @ChapterContentSection(&chapter, options)

                    <nav class="book-reader__chapter-navigation" aria-label={ l.T("reader.chapterNavigation") }>
                        if chapter.PrevChapter.Valid {
                            <a class="book-reader__chapter-link book-reader__chapter-link--previous"
                                href={ templ.SafeURL(fmt.Sprintf("/book/%d/chapters/%d", book.ID, chapter.PrevChapter.Value.ID)) }>
                                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                                <span><small>{ l.T("reader.previous") }</small>{ chapter.PrevChapter.Value.Name }</span>
                            </a>
                        } else {
                            <span />
                        }

                        if chapter.NextChapter.Valid {
                            <a class="book-reader__chapter-link book-reader__chapter-link--next"
                                href={ templ.SafeURL(fmt.Sprintf("/book/%d/chapters/%d", book.ID, chapter.NextChapter.Value.ID)) }>
                                <span><small>{ l.T("reader.next") }</small>{ chapter.NextChapter.Value.Name }</span>
                                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        } else {
                            <span />
                        }
                    </nav>

                    <div class="mt-8">
                        <a class="btn btn--ghost btn--lg" href={ fmt.Sprintf("/book/%d/chapters/%d/comments", chapter.BookID, chapter.ID) }>
                            <i class="fa-solid fa-comments"></i>
                            { l.TData("common.commentsCount", map[string]int64{
                                "Count": chapter.CommentsCount,
                            }) }
                        </a>
                    </div>
                </div>
            </div>

            @ChapterReaderSettings(preferences, isAuthenticated)
        </div>
    }
}

templ ChapterContentIframe() {
    @htmlLayout(htmlLayoutProps{
        CSS: []string{
            "/_/assets/block-editor.css",
        },
    }) {
        <div id="BlockEditorWrap">
            <div id="BlockEditorWrapHeader"></div>
            @ChapterContent("")
        </div>
    }
}

templ ChapterContentSection(chapter *app.ChapterDto, options ChapterProgressTrackerOptions) {
    {{
        l := i18n.GetLocalizer(ctx)
    }}

    <header class="book-reader__header">
        <h1 class="text-3xl font-title">{ chapter.Name }</h1>
    
        <p class="mt-2 text-secondary-foreground">
            { l.TData("book.words", map[string]string{
                "count": commonutil.FormatInt(int(chapter.Words)),
            }) } &bull; <time datetime={ chapter.CreatedAt.String() }>{ relativeTime(l, chapter.CreatedAt) }</time>
        </p>
    </header>


    if options.Enable {
        <script>
            window.__markChapterAsRead = async () => {
                if (window.IS_BOT) return;
                await fetch(`/_api/reading-list/chapter?chapterId=${__server__.chapterId}`,{method:'POST'});
            };
        </script>
        if !options.JumpedBackward && !options.JumpedForward {
            <script>
            if (window.FIRST_USER_ACTIVITY) {
                window.__markChapterAsRead();
            } else {
                document.addEventListener('first_user_activity', () => {
                    window.__markChapterAsRead()
                });
            }
            </script>
        } else {
            <section 
                x-data="{status:0}"
                x-show="status!=2"
                class="card card--elevated mb-8 grid grid-cols-[auto_1fr] gap-2">
                <p>
                    if options.JumpedBackward {
                        { l.T("book.readingListYouJumpedBack") }
                    } else if options.JumpedForward {
                        { l.T("book.readingListYouJumpedForward") }
                    }
                </p>
                <div>
                    <button
                        class="btn btn--secondary relative" 
                        :disabled="status==1"
                        @click="if (status != 0) return; status = 1; window.__markChapterAsRead().then(() => {status=2;})">
                        <div :style="`opacity:${status==1 ? 0 : 1}`">
                            <i class="fa-solid fa-bookmark"></i>
                            { l.T("book.readingListSetProgress") }
                        </div>
                        <div x-cloak x-show="status==1" class="flex items-center justify-center absolute inset-0">
                            <span class="loader" />
                        </div>
                    </button>
                </div>
            </section>
        }
    }
    
    @ChapterContent(chapter.Content)

    <div x-data="pageProgress" data-content-element="#ChapterContent" class="fixed w-screen left-0 h-1 bg-primary z-10 origin-left rtl:origin-right" style="top: var(--header-height)" x-cloak />
    <script src="/_/assets/book-reader.js"></script>
}

// wrapper component for chapter content
// devoid of any logic
templ ChapterContent(content string) {
    <article class="chapter-content user-content" id="ChapterContent">
        @templ.Raw(content)
    </article>
}

templ ChapterComments(
    chapter app.ChapterDto,
    book app.BookDetailsDto,
    result app.GetCommentsResult,
    replies map[int64]app.GetCommentRepliesResult,
    sort app.CommentSort,
) {
    {{
        l := i18n.GetLocalizer(ctx)
        user, isAuthenticated := auth.GetUser(ctx)
    }}
    @standardPageLayout(standardPageLayoutProps{
        DisableFooter: true,
    }) {
        @olhttp.JSServerData("chapterId", fmt.Sprintf("%d", chapter.ID))
        <main class="ol-container py-8">
          <section class="ol-comments" aria-labelledby="chapter-comments-title">
            <header class="ol-comments__heading-row">
              <div>
                <p class="ol-comments__eyebrow">{ l.T("comments.chapterDiscussion") }</p>
                <h1 class="ol-comments__title" id="chapter-comments-title">{ l.T("comments.title") }</h1>
                <p class="ol-comments__context">
                  <a class="link" href={ templ.SafeURL(fmt.Sprintf("/book/%d", book.ID)) }>{ book.Name }</a>
                  <span aria-hidden="true"> · </span>
                  <a class="link" href={ templ.SafeURL(fmt.Sprintf("/book/%d/chapters/%d", book.ID, chapter.ID)) }>{ chapter.Name }</a>
                </p>
              </div>
              <span class="ol-comments__count">{ l.TData("common.commentsCount", map[string]int64{"Count": result.Total}) }</span>
            </header>

            if isAuthenticated {
              <form class="ol-comment-composer" x-data={ fmt.Sprintf("{content:'', submitting:false, async submit() { this.submitting=true; try { const response = await fetch('/_api/comments/add', {method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify({chapterId:'%d', content:this.content})}); if (!response.ok) throw new Error('Could not post comment'); window.location.reload() } catch (error) { window.toast.error(error) } finally { this.submitting=false } }}", chapter.ID) } @submit.prevent="submit">
                <img class="ol-comment__avatar" src={ user.Avatar.MD } alt="" />
                <div class="ol-comment-composer__body">
                  <label class="sr-only" for="ChapterCommentContent">{ l.T("comments.shareThoughts") }</label>
                  <textarea id="ChapterCommentContent" class="ol-comment-composer__input" maxlength="2000" required x-model="content" placeholder={ l.T("comments.shareThoughts") }></textarea>
                  <div class="ol-comment-composer__footer">
                    <p class="ol-comment-composer__hint">{ l.T("comments.kindHint") }</p>
                    <div class="ol-comment-composer__actions">
                      <button type="button" class="btn btn--outline" @click="alert('Not implemented yet')">{ l.T("comments.preview") }</button>
                      <button type="submit" class="btn btn--default" :disabled="submitting || !content.trim()">{ l.T("comments.post") }</button>
                    </div>
                  </div>
                </div>
              </form>
            } else {
              <div class="ol-comments__signin card">
                <a class="btn btn--default" href="/login">{ l.T("comments.signInToComment") }</a>
              </div>
            }

            <div class="ol-comments__toolbar">
              <span class="ol-comments__toolbar-title">{ l.T("comments.discussion") }</span>
              <form method="get">
                <label class="sr-only" for="ChapterCommentsSort">{ l.T("comments.sort") }</label>
                <select id="ChapterCommentsSort" class="ol-comments__sort" name="sort" @change="$el.form.submit()">
                  <option value="newest" selected?={ sort == app.CommentSortNewest }>{ l.T("comments.newest") }</option>
                  <option value="oldest" selected?={ sort == app.CommentSortOldest }>{ l.T("comments.oldest") }</option>
                  <option value="popular" selected?={ sort == app.CommentSortPopular }>{ l.T("comments.popular") }</option>
                </select>
              </form>
            </div>

            <div id="ChapterCommentsList" class="ol-comment-list" x-merge="append">
              if len(result.Comments) == 0 {
                <p class="ol-comments__empty">{ l.T("comments.empty") }</p>
              }
              @ChapterCommentsFragment(result.Comments, replies, result.NextCursor)
            </div>
          </section>
        </main>
    }
}

templ ChapterCommentsFragment(
    comments []app.CommentDto, 
    replies map[int64]app.GetCommentRepliesResult,
    nextCursor uint32,
) {
    {{
        r := olhttp.GetRequest(ctx)
        url := *r.URL
        urlQuery := url.Query()
        urlQuery.Set("cursor", strconv.FormatInt(int64(nextCursor), 10))
        urlQuery.Set("ajax", "1")
        url.RawQuery = urlQuery.Encode()
        l := i18n.GetLocalizer(ctx)
    }}

    for _, comment := range comments {
                <article class="ol-comment"
                    x-data={fmt.Sprintf("Comment({id:'%d',liked:%t,replies:%d})", comment.ID, comment.LikedAt.Valid, comment.Subcomments)}>
                    <img class="ol-comment__avatar" src={ comment.User.Avatar } alt="" />
                    <div class="ol-comment__body">
                      <header class="ol-comment__header">
                        <a href={ templ.URL(fmt.Sprintf("/users/%s", comment.User.ID)) } class="ol-comment__author">{ comment.User.Name }</a>
                        <time class="ol-comment__meta" datetime={ comment.CreatedAt.Format(time.RFC3339) }>{ relativeTime(l, comment.CreatedAt) }</time>
                        if comment.UpdatedAt.Valid {
                          <span class="ol-comment__meta">{ l.T("comments.edited") }</span>
                        }
                      </header>
                      <div class="ol-comment__content">
                        @webcomponents.UserContent(webcomponents.UserContentProps{
                            Content: comment.Content,
                        })
                      </div>
                      <div class="ol-comment__actions">
                        <button class="ol-comment-action" x-bind="like" aria-label={ l.T("comments.like") }
                            if comment.LikedAt.Valid {
                                data-set="true"
                                aria-pressed="true"
                            } else { aria-pressed="false" }>
                            <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                            {{
                                likes := comment.RealLikesCount()
                            }}
                            if likes > 0 {
                                { likes }
                            }
                        </button>

                        <button class="ol-comment-action" x-bind="reply">
                            <i class="fa-solid fa-reply"></i>&nbsp;{ l.T("common.reply") }
                        </button>
                        <button class="ol-comment-action" type="button" @click="alert('Not implemented yet')">
                          <i class="fa-solid fa-ellipsis" aria-hidden="true"></i> { l.T("common.more") }
                        </button>
                    </div>

                    <div class="ol-comment-replies" x-ref="replies">
                        <div x-ref="slotReply" class="contents" />
                        {{ initialRepliesJSON, _ := templ.JSONString(replies[comment.ID].Comments) }}
                        <div
                            x-ref="slotReplies"
                            class="contents"
                            data-initial-replies={ initialRepliesJSON }
                            data-next-cursor={ strconv.FormatInt(int64(replies[comment.ID].NextCursor), 10) }>
                            for _, reply := range replies[comment.ID].Comments {
                                @ChapterCommentReply(reply)
                            }
                            if replies[comment.ID].NextCursor > 0 {
                                <button class="btn btn--ghost mt-2" type="button">
                                    { l.T("common.loadMore") }
                                </button>
                            }
                        </div>
                    </div>
                  </div>
                </article>
    }
        if nextCursor > 0 {
            <button 
                x-init 
                @click={fmt.Sprintf("$ajax(%q, {target:'ChapterCommentsList ChapterCommentNext'})", url.String())} 
                id="ChapterCommentNext" 
                class="btn btn--ghost btn--lg mt-4">
                { l.T("common.loadMore") }
            </button>
        }
}

templ ChapterCommentReply(reply app.CommentDto) {
    {{ l := i18n.GetLocalizer(ctx) }}
    <article class="ol-comment">
        <img class="ol-comment__avatar" src={ reply.User.Avatar } alt="" />
        <div class="ol-comment__body">
            <header class="ol-comment__header">
                <strong class="ol-comment__author">{ reply.User.Name }</strong>
                <time class="ol-comment__meta" datetime={ reply.CreatedAt.Format(time.RFC3339) }>{ relativeTime(l, reply.CreatedAt) }</time>
            </header>
            <div class="ol-comment__content">
                @webcomponents.UserContent(webcomponents.UserContentProps{Content: reply.Content})
            </div>
            <div class="ol-comment__actions">
                <button class="ol-comment-action" aria-pressed={ strconv.FormatBool(reply.LikedAt.Valid) }>
                    <i class="fa-solid fa-arrow-up"></i>
                    if reply.RealLikesCount() > 0 {
                        { reply.RealLikesCount() }
                    }
                </button>
                <button class="ol-comment-action" type="button" @click="alert('Not implemented yet')">
                    <i class="fa-solid fa-ellipsis"></i> { l.T("common.more") }
                </button>
            </div>
        </div>
    </article>
}
