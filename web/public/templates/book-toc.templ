package templates

import "github.com/MaratBR/openlibrary/internal/app"
import "github.com/MaratBR/openlibrary/internal/i18n"
import "github.com/MaratBR/openlibrary/internal/commonutil"
import "fmt"

templ bookTOCPanel(bookID int64, chapters []app.ChapterListDto, activeChapterID int64, adminOverride bool) {
    {{ l := i18n.GetLocalizer(ctx) }}
    <div role="tabpanel" aria-labelledby="book-tab-toc" tabindex="0" class="BookPage-panel" id="slot-book-toc" x-show="tab==='toc'">
        if len(chapters) == 0 {
            <section id="empty_toc" class="BookToc-empty">
                <h1>{l.T("book.emptyToc")}</h1>
                <p>{l.T("book.emptyTocContent")}</p>
            </section>
        } else {
            <ol-scroll-blocker />
            <div class="BookToc">
                <ul class="contain-layout p-1 contain-paint">
                    for i, chapter := range chapters {
                        <li class="BookToc-entry" role="listitem" aria-label={ chapter.Name }>
                            <a
                                href={ templ.SafeURL(publicBookURL(ctx, fmt.Sprintf("/book/%d/chapters/%d", bookID, chapter.ID), adminOverride)) }
                                if chapter.ID == activeChapterID {
                                    class="BookToc-item BookToc-item--readingNow" aria-current="page"
                                } else {
                                    class="BookToc-item"
                                }
                                >
                                <div class="BookToc-num" aria-hidden="true">
                                    <span>{ commonutil.FormatInt(i + 1) }</span>
                                    if chapter.ID == activeChapterID {
                                        <span class="BookToc-mark">
                                            <i class="fa-solid fa-bookmark"></i>
                                        </span>
                                    }
                                </div>
                                <div class="BookToc-copy">
                                    <div class="BookToc-title">{ chapter.Name }</div>
                                    <span class="BookToc-meta">
                                        {relativeTime(l, chapter.CreatedAt)},&nbsp;
                                        { _tt(l, "book.words", map[string]string{"count": commonutil.FormatInt(chapter.Words)}) }
                                    </span>
                                </div>
                                <i class="BookToc-arrow fa-solid fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
}
