package templates

import "github.com/MaratBR/openlibrary/internal/app"
import "github.com/MaratBR/openlibrary/internal/i18n"
import "strconv"

templ ChapterReaderSettings(preferences app.ReaderPreferences, isAuthenticated bool) {
    {{ l := i18n.GetLocalizer(ctx) }}
    <div class="book-reader__settings-backdrop" x-cloak x-show="settingsOpen" @click="settingsOpen = false"></div>
    <aside class="book-reader__settings" x-cloak x-bind="settings" aria-labelledby="reader-settings-title">
        <header class="book-reader__settings-header">
            <div>
                <h2 id="reader-settings-title" class="font-title text-xl font-semibold">{ l.T("reader.settings") }</h2>
                <p class="text-sm text-secondary-foreground">
                    if isAuthenticated {
                        { l.T("reader.savedToAccount") }
                    } else {
                        { l.T("reader.savedToDevice") }
                    }
                </p>
            </div>
            <button x-bind="closeButton" class="btn btn--icon btn--ghost" aria-label={ l.T("common.close") }>
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>

        <div class="book-reader__settings-content">
            <fieldset class="reader-setting">
                <legend>{ l.T("reader.fontSize") }</legend>
                <div class="reader-setting__stepper">
                    <button x-bind="decreaseFont" class="btn btn--icon btn--ghost" aria-label={ l.T("reader.decreaseFontSize") }>
                        <i class="fa-solid fa-minus" aria-hidden="true"></i>
                    </button>
                    <output x-text="`${fontSize}px`">{ strconv.Itoa(int(preferences.FontSize)) }px</output>
                    <button x-bind="increaseFont" class="btn btn--icon btn--ghost" aria-label={ l.T("reader.increaseFontSize") }>
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    </button>
                </div>
            </fieldset>

            <fieldset class="reader-setting">
                <legend>{ l.T("reader.font") }</legend>
                <div class="reader-setting__choices reader-setting__choices--stacked">
                    @readerSettingChoice("fontFamily", app.ReaderFontSerif, l.T("reader.fontSerif"), "font-family: Merriweather, serif")
                    @readerSettingChoice("fontFamily", app.ReaderFontSans, l.T("reader.fontSans"), "font-family: 'Atkinson Hyperlegible', sans-serif")
                    @readerSettingChoice("fontFamily", app.ReaderFontDyslexic, l.T("reader.fontDyslexic"), "font-family: OpenDyslexic, sans-serif")
                </div>
            </fieldset>

            <fieldset class="reader-setting">
                <legend>{ l.T("reader.pageColor") }</legend>
                <div class="reader-setting__choices">
                    @readerSettingChoice("pageColor", app.ReaderPageBackground, l.T("reader.background"), "")
                    @readerSettingChoice("pageColor", app.ReaderPageSurface, l.T("reader.surface"), "")
                </div>
            </fieldset>

            <fieldset class="reader-setting">
                <legend>{ l.T("reader.theme") }</legend>
                <div class="reader-setting__choices reader-setting__choices--stacked">
                    @readerSettingChoice("readerTheme", app.ReaderThemeSystem, l.T("reader.themeWebsite"), "")
                    @readerSettingChoice("readerTheme", app.ReaderThemeLight, l.T("reader.themeLight"), "")
                    @readerSettingChoice("readerTheme", app.ReaderThemeDark, l.T("reader.themeDark"), "")
                </div>
            </fieldset>
        </div>
    </aside>
}

templ readerSettingChoice(model, value, label, style string) {
    <label class="reader-setting__choice" style={ style }>
        <input type="radio" x-model={ model } value={ value } @change="applyPreferences()" />
        <span>{ label }</span>
    </label>
}
