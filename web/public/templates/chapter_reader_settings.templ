package templates

import "github.com/MaratBR/openlibrary/internal/app"
import "github.com/MaratBR/openlibrary/internal/i18n"
import "strconv"

templ ChapterReaderSettings(preferences app.ReaderPreferences, isAuthenticated bool, fonts []app.ReaderFont) {
    {{ l := i18n.GetLocalizer(ctx) }}
    <div
        class="BookReader-settingsBackdrop"
        x-cloak
        x-show="settingsOpen"
        x-transition:enter="reader-backdrop-transition"
        x-transition:enter-start="reader-backdrop-hidden"
        x-transition:leave="reader-backdrop-transition"
        x-transition:leave-end="reader-backdrop-hidden"
        @click="settingsOpen = false"></div>
    <aside
        class="BookReader-settings"
        x-cloak
        x-bind="settings"
        x-transition:enter="reader-settings-transition"
        x-transition:enter-start="reader-settings-hidden"
        x-transition:leave="reader-settings-transition"
        x-transition:leave-end="reader-settings-hidden"
        aria-labelledby="reader-settings-title">
        <header class="BookReader-settingsHeader">
            <div class="BookReader-settingsHeading">
                <span class="BookReader-settingsMark" aria-hidden="true"><i class="fa-solid fa-sliders"></i></span>
                <h2 id="reader-settings-title">{ l.T("reader.settings") }</h2>
                <p class="BookReader-settingsSaved">
                    <span class="BookReader-settingsSavedDot" aria-hidden="true"></span>
                    if isAuthenticated {
                        { l.T("reader.savedToAccount") }
                    } else {
                        { l.T("reader.savedToDevice") }
                    }
                </p>
            </div>
            <button x-bind="closeButton" class="Btn Btn--icon Btn--ghost BookReader-settingsClose" aria-label={ l.T("common.close") }>
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>

        <div class="BookReader-settingsContent">
            <fieldset class="ReaderSetting">
                <legend class="ReaderSetting-label">{ l.T("reader.theme") }</legend>
                <div class="ReaderSetting-themes">
                    @readerThemeChoice(app.ReaderThemeSystem, l.T("reader.themeWebsite"), "fa-desktop")
                    @readerThemeChoice(app.ReaderThemeLight, l.T("reader.themeLight"), "fa-sun")
                    @readerThemeChoice(app.ReaderThemeDark, l.T("reader.themeDark"), "fa-moon")
                    @readerThemeChoice(app.ReaderThemeOLED, l.T("reader.themeOLED"), "fa-circle")
                </div>
            </fieldset>

            <fieldset class="ReaderSetting">
                <legend class="ReaderSetting-label">{ l.T("reader.font") }</legend>
                <div class="ReaderSetting-fonts">
                    for _, font := range fonts {
                        <label class="ReaderSetting-choice ReaderSetting-font" style={ "font-family: " + font.Family }>
                            <input type="radio" name="fontFamily" x-model="fontFamily" value={ font.ID } data-font-stack={ font.Family } @change="$nextTick(() => applyPreferences())"/>
                            <span class="ReaderSetting-fontSample" aria-hidden="true">Aa</span>
                            <span class="ReaderSetting-fontLabel">{ l.T(font.LabelKey) }</span>
                            <span class="ReaderSetting-selected" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                        </label>
                    }
                </div>
            </fieldset>
            <fieldset class="ReaderSetting">
                <legend class="ReaderSetting-label">{ l.T("reader.fontSize") }</legend>
                <div class="ReaderSetting-stepper">
                    <button x-bind="decreaseFont" class="Btn Btn--icon Btn--ghost" aria-label={ l.T("reader.decreaseFontSize") }>
                        <i class="fa-solid fa-minus" aria-hidden="true"></i>
                    </button>
                    <output x-text="`${fontSize}px`">{ strconv.Itoa(int(preferences.FontSize)) }px</output>
                    <button x-bind="increaseFont" class="Btn Btn--icon Btn--ghost" aria-label={ l.T("reader.increaseFontSize") }>
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    </button>
                </div>
            </fieldset>





            <fieldset class="ReaderSetting">
                <legend class="ReaderSetting-label">{ l.T("reader.contentWidth") }</legend>
                <div class="ReaderSetting-width">
                    <span class="ReaderSetting-widthPreview" aria-hidden="true"><span :style="{ width: contentWidth + '%' }"><span/><span/><span/><span/></span></span>
                    <div class="flex items-center justify-between gap-3">
                        <i class="fa-solid fa-arrows-left-right text-secondary-foreground" aria-hidden="true"></i>
                        <output for="reader-content-width" x-text="contentWidth + 'ch'">{ strconv.Itoa(int(preferences.ContentWidth)) }ch</output>
                    </div>
                    <input id="reader-content-width" type="range" min="48" max="100" step="2" x-model.number="contentWidth" @input="$nextTick(() => applyPreferences())" aria-label={ l.T("reader.contentWidth") }/>
                    <div class="flex justify-between text-xs text-secondary-foreground">
                        <span>{ l.T("reader.widthNarrow") }</span>
                        <span>{ l.T("reader.widthWide") }</span>
                    </div>
                </div>
            </fieldset>


            <fieldset class="ReaderSetting">
                <legend class="ReaderSetting-label">{ l.T("reader.pageColor") }</legend>
                <div class="ReaderSetting-choices ReaderSetting-paper">
                    @readerSettingChoice("pageColor", app.ReaderPageBackground, l.T("reader.background"), "")
                    @readerSettingChoice("pageColor", app.ReaderPageSurface, l.T("reader.surface"), "")
                </div>
            </fieldset>
        </div>
    </aside>
}

templ readerSettingChoice(model, value, label, style string) {
    <label class="ReaderSetting-choice" style={ style }>
        <input type="radio" name={ model } x-model={ model } value={ value } @change="$nextTick(() => applyPreferences())" />
        <span class="ReaderSetting-paperSwatch" data-paper={ value } aria-hidden="true"></span>
        <span>{ label }</span>
    </label>
}

templ readerThemeChoice(value, label, icon string) {
    <label class="ReaderSetting-theme">
        <input type="radio" name="readerTheme" x-model="readerTheme" value={ value } @change="$nextTick(() => applyPreferences())"/>
        <span class="ReaderSetting-themePreview" data-theme-preview={ value } aria-hidden="true">
            <i class={ "fa-solid " + icon }></i>
            <span class="ReaderSetting-previewPage"><span class="ReaderSetting-previewType">Aa</span><span class="ReaderSetting-previewLines"><span/><span/><span/></span></span>
        </span>
        <span class="ReaderSetting-themeLabel">{ label }</span>
        <span class="ReaderSetting-selected" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
    </label>
}
