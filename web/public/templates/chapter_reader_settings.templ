package templates

import "github.com/MaratBR/openlibrary/internal/app"
import "github.com/MaratBR/openlibrary/internal/i18n"
import "strconv"

templ ChapterReaderSettings(preferences app.ReaderPreferences, isAuthenticated bool) {
    {{ l := i18n.GetLocalizer(ctx) }}
    <div
        class="BookReader-settingsBackdrop"
        x-cloak
        x-show="settingsOpen"
        x-transition:enter="reader-backdrop-transition"
        x-transition:enter-start="reader-backdrop-hidden"
        x-transition:leave="reader-backdrop-transition"
        x-transition:leave-end="reader-backdrop-hidden"
        @click="settingsOpen = false"></div>
    <aside
        class="BookReader-settings"
        x-cloak
        x-bind="settings"
        x-transition:enter="reader-settings-transition"
        x-transition:enter-start="reader-settings-hidden"
        x-transition:leave="reader-settings-transition"
        x-transition:leave-end="reader-settings-hidden"
        aria-labelledby="reader-settings-title">
        <header class="BookReader-settingsHeader">
            <div>
                <h2 id="reader-settings-title" class="font-title text-2xl font-semibold">{ l.T("reader.settings") }</h2>
                <p class="mt-1 text-sm text-secondary-foreground">
                    if isAuthenticated {
                        { l.T("reader.savedToAccount") }
                    } else {
                        { l.T("reader.savedToDevice") }
                    }
                </p>
            </div>
            <button x-bind="closeButton" class="Btn Btn--icon Btn--ghost" aria-label={ l.T("common.close") }>
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>

        <div class="BookReader-settingsContent">
            <fieldset class="ReaderSetting">
                <legend class="ReaderSetting-label">{ l.T("reader.fontSize") }</legend>
                <div class="ReaderSetting-stepper">
                    <button x-bind="decreaseFont" class="Btn Btn--icon Btn--ghost" aria-label={ l.T("reader.decreaseFontSize") }>
                        <i class="fa-solid fa-minus" aria-hidden="true"></i>
                    </button>
                    <output x-text="`${fontSize}px`">{ strconv.Itoa(int(preferences.FontSize)) }px</output>
                    <button x-bind="increaseFont" class="Btn Btn--icon Btn--ghost" aria-label={ l.T("reader.increaseFontSize") }>
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    </button>
                </div>
            </fieldset>

            <fieldset class="ReaderSetting">
                <legend class="ReaderSetting-label">{ l.T("reader.font") }</legend>
                <div class="ReaderSetting-choices ReaderSettingChoices--stacked">
                    @readerSettingChoice("fontFamily", app.ReaderFontSerif, l.T("reader.fontSerif"), "font-family: Merriweather, serif")
                    @readerSettingChoice("fontFamily", app.ReaderFontSans, l.T("reader.fontSans"), "font-family: 'Atkinson Hyperlegible', sans-serif")
                    @readerSettingChoice("fontFamily", app.ReaderFontDyslexic, l.T("reader.fontDyslexic"), "font-family: OpenDyslexic, sans-serif")
                </div>
            </fieldset>

            <fieldset class="ReaderSetting">
                <legend class="ReaderSetting-label">{ l.T("reader.pageColor") }</legend>
                <div class="ReaderSetting-choices">
                    @readerSettingChoice("pageColor", app.ReaderPageBackground, l.T("reader.background"), "")
                    @readerSettingChoice("pageColor", app.ReaderPageSurface, l.T("reader.surface"), "")
                </div>
            </fieldset>

            <label class="ReaderSetting block">
                <span class="ReaderSetting-label">{ l.T("reader.theme") }</span>
                <select class="Select" x-model="readerTheme" @change="$nextTick(() => applyPreferences())">
                    <option value={ app.ReaderThemeSystem }>{ l.T("reader.themeWebsite") }</option>
                    <option value={ app.ReaderThemeLight }>{ l.T("reader.themeLight") }</option>
                    <option value={ app.ReaderThemeDark }>{ l.T("reader.themeDark") }</option>
                </select>
            </label>
        </div>
    </aside>
}

templ readerSettingChoice(model, value, label, style string) {
    <label class="ReaderSetting-choice" style={ style }>
        <input type="radio" x-model={ model } value={ value } @change="$nextTick(() => applyPreferences())" />
        <span>{ label }</span>
    </label>
}
