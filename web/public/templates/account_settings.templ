package templates

import "fmt"
import "github.com/MaratBR/openlibrary/internal/i18n"

templ AccountSettings(settingsType string, settings any, tagLabels ...map[string]string) {
	{{
		l := i18n.GetLocalizer(ctx)
		settingsJSON, _ := templ.JSONString(settings)
		labels := map[string]string{}
		if len(tagLabels) > 0 { labels = tagLabels[0] }
		labelsJSON, _ := templ.JSONString(labels)
		dataExpression := fmt.Sprintf("accountSettings(%s, %q, %s)", settingsJSON, "/account/settings/"+settingsType, labelsJSON)
	}}
	@standardPageLayout(standardPageLayoutProps{
		htmlLayoutProps: htmlLayoutProps{
			Title: l.T("common.settings"),
		},
	}) {
		<main class="AccountSettings OlContainer OlContainer--big">
			<header class="AccountSettings-masthead">
				<h1>{ l.T("common.settings") }</h1>
				<p>{ l.T("accountSettings.automaticSave") }</p>
			</header>
			<div class="AccountSettings-layout">
				<aside class="AccountSettings-sidebar">
					<nav aria-label={ l.T("accountSettings.navigation") }>
						<ul class="AccountSettings-navigation">
							@settingsNavigationItem(settingsType, "about", "fa-solid fa-user", l.T("accountSettings.about.title"))
							@settingsNavigationItem(settingsType, "privacy", "fa-solid fa-lock", l.T("accountSettings.privacy.title"))
							@settingsNavigationItem(settingsType, "moderation", "fa-solid fa-shield-halved", l.T("accountSettings.moderation.title"))
							@settingsNavigationItem(settingsType, "customization", "fa-solid fa-palette", l.T("accountSettings.customization.title"))
						</ul>
					</nav>
				</aside>

				<section class="AccountSettings-panel" x-data={ dataExpression }>
					<header class="AccountSettings-header">
						<h2 class="AccountSettings-title">{ settingsTitle(l, settingsType) }</h2>
						<div class="AccountSettings-status" role="status" aria-live="polite" aria-atomic="true">
							<span x-cloak x-show="saveState === 'saving'">{ l.T("accountSettings.saving") }</span>
							<span x-cloak x-show="saveState === 'saved'">{ l.T("accountSettings.saved") }</span>
							<span x-cloak x-show="saveState === 'error'" class="text-destructive">{ l.T("accountSettings.saveError") }</span>
						</div>
					</header>

					switch settingsType {
						case "about":
							@aboutSettingsFields(l)
						case "privacy":
							@privacySettingsFields(l)
						case "moderation":
							@moderationSettingsFields(l)
						case "customization":
							@customizationSettingsFields(l)
					}
				</section>
			</div>
		</main>
		<script>
			function accountSettings(initialSettings, endpoint, initialTagLabels) {
				return {
					settings: initialSettings,
                    tagLabels: initialTagLabels,
                    tagQuery: '',
                    tagResults: [],
                    tagSearchState: 'idle',
                    tagSearchVersion: 0,

                    async searchTags() {
                        const version = ++this.tagSearchVersion
                        if (!this.tagQuery.trim()) { this.tagResults = []; this.tagSearchState = 'idle'; return }
                        this.tagSearchState = 'loading'
                        try {
                            const response = await fetch('/account/settings/moderation/tags?q=' + encodeURIComponent(this.tagQuery))
                            if (!response.ok) throw new Error('Tag search failed')
                            const tags = await response.json()
                            if (version !== this.tagSearchVersion) return
                            this.tagResults = tags.filter(tag => !this.settings.censoredTags.includes(tag.id))
                            this.tagSearchState = 'ready'
                        } catch (error) {
                            if (version !== this.tagSearchVersion) return
                            this.tagResults = []
                            this.tagSearchState = 'error'
                        }
                    },
                    addTag(tag) {
                        if (this.settings.censoredTags.length >= 100) return
                        this.tagLabels[tag.id] = tag.name
                        this.settings.censoredTags = [...this.settings.censoredTags, tag.id]
                        this.tagQuery = ''
                        this.tagResults = []
                        ++this.tagSearchVersion
                        this.requestSave()
                    },
                    removeTag(id) {
                        this.settings.censoredTags = this.settings.censoredTags.filter(value => value !== id)
                        this.requestSave()
                    },
					saveState: 'idle',
					dirty: false,
					inFlight: false,
					timer: undefined,

					requestSave() {
						this.dirty = true
						this.saveState = 'saving'
						window.clearTimeout(this.timer)
						this.timer = window.setTimeout(() => this.flushSave(), 500)
					},

					async flushSave() {
						if (this.inFlight || !this.dirty) return
						this.dirty = false
						this.inFlight = true

						try {
							const response = await fetch(endpoint, {
								method: 'PATCH',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify(this.settings),
							})
							if (!response.ok) throw new Error(`Settings request failed: ${response.status}`)
							this.saveState = this.dirty ? 'saving' : 'saved'
						} catch (error) {
							console.error(error)
							this.saveState = 'error'
						} finally {
							this.inFlight = false
							if (this.dirty) this.flushSave()
						}
					},
				}
			}
		</script>
	}
}

templ settingsNavigationItem(activeType string, itemType string, icon string, label string) {
	<li>
		<a
			href={ templ.SafeURL("/account/settings/" + itemType) }
			class="AccountSettings-link"
			if activeType == itemType {
				aria-current="page"
			}
		>
			<i class={ icon, "w-5 text-center" } aria-hidden="true"></i>
			<span>{ label }</span>
		</a>
	</li>
}

func settingsTitle(l *i18n.Localizer, settingsType string) string {
	return l.T("accountSettings." + settingsType + ".title")
}

templ settingsField(label string, description string) {
	<div class="AccountSettings-field" x-id="['setting-control', 'setting-description']">
		<div>
			<label class="AccountSettings-label" :for="$id('setting-control')">{ label }</label>
			<p class="AccountSettings-description" :id="$id('setting-description')">{ description }</p>
		</div>
		<div class="AccountSettings-control">{ children... }</div>
	</div>
}

templ settingsSwitch(model string, label string) {
	<label class="inline-flex items-center gap-3">
		<span class="Switch">
			<input :id="$id('setting-control')" :aria-describedby="$id('setting-description')" type="checkbox" x-model={ model } @change="requestSave()"/>
			<span class="Switch-slider"></span>
		</span>
		<span class="sr-only">{ label }</span>
	</label>
}

templ aboutSettingsFields(l *i18n.Localizer) {
	<div>
		@settingsField(l.T("accountSettings.about.biography"), l.T("accountSettings.about.biographyDescription")) {
			<textarea :id="$id('setting-control')" :aria-describedby="$id('setting-description')" class="textarea min-h-40" x-model="settings.about" @input="requestSave()"></textarea>
		}
		@settingsField(l.T("accountSettings.about.gender"), l.T("accountSettings.about.genderDescription")) {
			<select :id="$id('setting-control')" :aria-describedby="$id('setting-description')" class="Select" x-model="settings.gender" @change="requestSave()">
				<option value="">{ l.T("gender.ratherNotSay") }</option>
				<option value="m">{ l.T("gender.m") }</option>
				<option value="f">{ l.T("gender.f") }</option>
				<option value="o">{ l.T("gender.o") }</option>
			</select>
		}
	</div>
}

templ privacySettingsFields(l *i18n.Localizer) {
	<div>
		@settingsField(l.T("accountSettings.privacy.hideStats"), l.T("accountSettings.privacy.hideStatsDescription")) {
			@settingsSwitch("settings.hideStats", l.T("accountSettings.privacy.hideStats"))
		}
		@settingsField(l.T("accountSettings.privacy.hideComments"), l.T("accountSettings.privacy.hideCommentsDescription")) {
			@settingsSwitch("settings.hideComments", l.T("accountSettings.privacy.hideComments"))
		}
		@settingsField(l.T("accountSettings.privacy.hideEmail"), l.T("accountSettings.privacy.hideEmailDescription")) {
			@settingsSwitch("settings.hideEmail", l.T("accountSettings.privacy.hideEmail"))
		}
		@settingsField(l.T("accountSettings.privacy.allowSearching"), l.T("accountSettings.privacy.allowSearchingDescription")) {
			@settingsSwitch("settings.allowSearching", l.T("accountSettings.privacy.allowSearching"))
		}
	</div>
}

templ moderationSettingsFields(l *i18n.Localizer) {
	<div>
		@settingsField(l.T("accountSettings.moderation.showAdultContent"), l.T("accountSettings.moderation.showAdultContentDescription")) {
			@settingsSwitch("settings.showAdultContent", l.T("accountSettings.moderation.showAdultContent"))
		}
		@settingsField(l.T("accountSettings.moderation.censoredTagsMode"), l.T("accountSettings.moderation.censoredTagsModeDescription")) {
			<select :id="$id('setting-control')" :aria-describedby="$id('setting-description')" class="Select" x-model="settings.censoredTagsMode" @change="requestSave()">
				<option value="none">{ l.T("accountSettings.moderation.censorModeNone") }</option>
				<option value="hide">{ l.T("accountSettings.moderation.censorModeHide") }</option>
				<option value="censor">{ l.T("accountSettings.moderation.censorModeCensor") }</option>
			</select>
		}
		@settingsField(l.T("accountSettings.moderation.censoredTags"), l.T("accountSettings.moderation.censoredTagsDescription")) {
			<div class="space-y-3">
                <ul class="flex flex-wrap gap-2" aria-label={ l.T("accountSettings.moderation.censoredTags") }>
                    <template x-for="id in settings.censoredTags" :key="id">
                        <li class="Chip flex items-center gap-2">
                            <span x-text="tagLabels[id] || id"></span>
                            <button type="button" class="Btn Btn--ghost Btn--sm" @click="removeTag(id)"
                                :aria-label={ fmt.Sprintf("%q + ' ' + (tagLabels[id] || id)", l.T("accountSettings.moderation.removeTag")) }>×</button>
                        </li>
                    </template>
                </ul>
                <label class="block" :for="$id('setting-control')">{ l.T("accountSettings.moderation.searchTags") }</label>
                <input :id="$id('setting-control')" :aria-describedby="$id('setting-description')" class="input w-full" type="search" autocomplete="off"
                    x-model="tagQuery" @input.debounce.250ms="searchTags()"
                    :disabled="settings.censoredTags.length >= 100"/>
                <p role="status" x-show="tagSearchState === 'loading'">{ l.T("accountSettings.moderation.searchingTags") }</p>
                <p role="alert" x-show="tagSearchState === 'error'">{ l.T("accountSettings.moderation.tagSearchError") }</p>
                <p role="status" x-show="tagSearchState === 'ready' && tagResults.length === 0">{ l.T("accountSettings.moderation.noTags") }</p>
                <ul class="space-y-1">
                    <template x-for="tag in tagResults" :key="tag.id">
                        <li><button type="button" class="Btn Btn--outline w-full text-left" @click="addTag(tag)" x-text="tag.name"></button></li>
                    </template>
                </ul>
            </div>
		}
	</div>
}

templ customizationSettingsFields(l *i18n.Localizer) {
	<div>
		@settingsField(l.T("accountSettings.customization.defaultTheme"), l.T("accountSettings.customization.defaultThemeDescription")) {
			<select :id="$id('setting-control')" :aria-describedby="$id('setting-description')" class="Select" x-model="settings.defaultTheme" @change="requestSave();OLTheme.theme.set(settings.defaultTheme||'system')">
				<option value="">{ l.T("uiTheme.system") }</option>
				<option value="light">{ l.T("uiTheme.light") }</option>
				<option value="dark">{ l.T("uiTheme.dark") }</option>
			</select>
		}
		@settingsField(l.T("accountSettings.customization.enableProfileCss"), l.T("accountSettings.customization.enableProfileCssDescription")) {
			@settingsSwitch("settings.enableProfileCss", l.T("accountSettings.customization.enableProfileCss"))
		}
		@settingsField(l.T("accountSettings.customization.profileCss"), l.T("accountSettings.customization.profileCssDescription")) {
			<textarea :id="$id('setting-control')" :aria-describedby="$id('setting-description')" class="textarea min-h-64 font-mono" x-model="settings.profileCss" @input="requestSave()" :disabled="!settings.enableProfileCss"></textarea>
		}
	</div>
}
