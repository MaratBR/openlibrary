  "narrative": {
    "northStar": "Publishing production desk",
    "overview": "A publishing production desk: calm, compact work surfaces with persistent navigation and clearly divided records. Forest navigation, warm neutral surfaces, and restrained green states support sustained scanning in light and dark themes.\n\nThis system applies only to administration, book management, and moderation. The public library and reading interface keep their incumbent visual system. Shared theme tokens and existing input controls are dependencies, not redesigned assets.",
    "keyCharacteristics": [
      "Persistent navigation with stable state geometry.",
      "Flat, ruled records and cover-led book rows.",
      "Sans-serif dashboard hierarchy in both themes.",
      "Existing controls, copy, and workflows preserved."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Use the existing semantic CSS variables; the dashboard must adapt to the current theme without replacing global tokens.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use shared semantic theme variables so both themes stay coherent.",
      "Do distinguish record groups with rules and spacing.",
      "Do keep keyboard focus visible and allow long record names to wrap.",
      "Do retain existing input controls and public-site styling."
    ],
    "donts": [
      "Don't apply dashboard heading or layout overrides outside the dashboard shell.",
      "Don't turn working records into oversized floating tiles.",
      "Don't move navigation geometry when a link becomes active."
    ]
  }
