      "html": "<button class=\"ds-primary\">Save changes</button>",
      "css": ".ds-primary{font-family:var(--font-text);font-size:.875rem;font-weight:500;border-radius:var(--radius);transition:background var(--transition-fast),color var(--transition-fast),box-shadow var(--transition-fast);height:calc(var(--spacing, .25rem)*10);padding:0 calc(var(--spacing, .25rem)*4);border:1px solid var(--primary);background:var(--primary);color:var(--primary-foreground);box-shadow:var(--shadow-xs)}.ds-primary:hover{background:color-mix(in srgb,var(--primary),black 12%);border-color:color-mix(in srgb,var(--primary),black 12%);box-shadow:var(--shadow-sm)}.ds-primary:active{background:color-mix(in srgb,var(--primary),black 20%);transform:translateY(1px)}.ds-primary:focus-visible{outline:0;box-shadow:var(--focus-ring)}"
