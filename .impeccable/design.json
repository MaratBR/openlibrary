      "css": ".ds-nav{padding:16px;background:var(--dashboard-rail,color-mix(in srgb,var(--primary) 92%,var(--foreground)));display:flex;flex-direction:column;gap:4px}.ds-nav a{display:flex;align-items:center;min-height:44px;padding:11px 12px;border-radius:6px;font-family:var(--font-text);font-size:.83rem;font-weight:500;line-height:1.5;text-decoration:none;color:var(--dashboard-rail-muted,var(--primary-foreground));transition:background var(--transition-fast),color var(--transition-fast)}.ds-nav a:hover{background:color-mix(in srgb,var(--dashboard-rail-ink,var(--primary-foreground)) 10%,transparent);color:var(--dashboard-rail-ink,var(--primary-foreground))}.ds-nav a[aria-current=page]{background:var(--dashboard-rail-ink,var(--primary-foreground));color:var(--dashboard-rail,color-mix(in srgb,var(--primary) 92%,var(--foreground)));font-weight:600}.ds-nav a:focus-visible{outline:2px solid var(--dashboard-rail-ink,var(--primary-foreground));outline-offset:3px}"
