package webcomponents

import "fmt"
import "strconv"

templ SiteLogo(size int) {
    {{
        sizeStr := strconv.FormatInt(int64(size), 10)
        style := fmt.Sprintf("width:%spx;height:%spx;min-width:%spx;min-height:%spx", sizeStr, sizeStr, sizeStr, sizeStr)
    }}
    <img style={style} width={sizeStr} height={sizeStr} class="dark:hidden" src="/_/embed-assets/logo.svg" />
    <img style={style} width={sizeStr} height={sizeStr} class="dark:block hidden" src="/_/embed-assets/logo-dark.svg" />
}

templ SiteHeaderLogo() {
    <a href="/" class="SiteHeader-logo">
        @SiteLogo(64)
    </a>
}

templ SiteHeaderRoot() {
    <header class="SiteHeader" id="site-header">
        <div class="SiteHeader-inner" x-data="{navOpen:false}">
            { children... }
        </div>
    </header>
}