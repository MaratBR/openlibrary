package olhttp

import "context"
import "net/url"
import "fmt"
import "github.com/MaratBR/openlibrary/internal/i18n"

func getPageURL(ctx context.Context, page uint32) templ.SafeURL {
    r := GetRequest(ctx)
    u := new(url.URL)
    *u = *r.URL
    query := u.Query()
    query.Del("__fragment")
    query.Set("p", fmt.Sprintf("%d", page))
    u.RawQuery = query.Encode()
    return templ.SafeURL(u.String())
}

templ Pagination(
    page, totalPages, size uint32,
) {
    @PaginationImpl(PaginationImplProps{
        Page: page,
        TotalPages: totalPages,
        Size: size,
    })
}

type PaginationImplProps struct {
    Page uint32
    TotalPages uint32
    Size uint32
    UseAlpineJsAjax bool
}

templ PaginationImpl(
    opts PaginationImplProps,
) {
    {{
        l := i18n.GetLocalizer(ctx)
        total := max(opts.TotalPages, 1)
        page := min(max(opts.Page, 1), total)
        pages := paginationPages(page, total, opts.Size)
    }}
    <nav class="Pagination" aria-label={ l.T("common.pagination") }>
        if page > 1 {
            @paginationLink(page - 1, l.T("common.previousPage"), opts.UseAlpineJsAjax, "fa-chevron-left")
        } else {
            <span class="Pagination-item Pagination-item--disabled" aria-disabled="true" aria-label={ l.T("common.previousPage") }><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></span>
        }
        for _, p := range pages {
            if p == 0 {
                <span class="Pagination-ellipsis" aria-hidden="true">…</span>
            } else if p == page {
                <span class="Pagination-item Pagination-item--active" aria-current="page" aria-label={ fmt.Sprintf("%s %d", l.T("common.page"), p) }>{ fmt.Sprintf("%d", p) }</span>
            } else {
                @paginationLink(p, fmt.Sprintf("%s %d", l.T("common.page"), p), opts.UseAlpineJsAjax, "")
            }
        }
        if page < total {
            @paginationLink(page + 1, l.T("common.nextPage"), opts.UseAlpineJsAjax, "fa-chevron-right")
        } else {
            <span class="Pagination-item Pagination-item--disabled" aria-disabled="true" aria-label={ l.T("common.nextPage") }><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></span>
        }
    </nav>
}

templ paginationLink(page uint32, label string, ajax bool, icon string) {
    <a href={ getPageURL(ctx, page) } class="Pagination-item" aria-label={ label }
        if ajax {
            x-target.push="PaginationAjaxSlot"
        }
    >
        if icon != "" {
            <i class={ "fa-solid", icon } aria-hidden="true"></i>
        } else {
            { fmt.Sprintf("%d", page) }
        }
    </a>
}
