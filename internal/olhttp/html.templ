package olhttp

import "github.com/MaratBR/openlibrary/internal/i18n"
import "github.com/mileusna/useragent"

type DocProps struct {
    Title string
    Scripts []string
    CSS []string
    InstantClick bool
    AppendToHead templ.Component
    BodyClasses string
    BodyAttributes templ.Attributes
}

templ Doc(
    props DocProps,
) {
    {{
        var lang string
        l, ok := i18n.TryGetLocalizer(ctx)
        if ok {
            lang = l.Lang().String()
        }
        r := GetRequest(ctx)
        var theme string
        {
            themeCookie, err := r.Cookie("_theme")
            if err == nil {
                theme = themeCookie.Value
            }
        }
    }}

    <!doctype html>
    <html 
        lang={lang}
        if theme == "dark" {
            class="theme-default dark"
        } else {
            class="theme-default"
        }
        >
    <head>
        if theme == "" {
            <script>window.matchMedia('(prefers-color-scheme: dark)').matches&&document.documentElement.classList.toggle('dark', true)</script>
        }
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        if l != nil && l.Passthrough() {
            <meta name="openlibrary-debug-meta:localizer-passthrough-mode" content="true" />
        }
        if useragent.Parse(r.UserAgent()).Bot {
            <script>window.IS_BOT=true</script>
        }
        <title>{ props.Title }</title>
        for _, scriptPath := range props.Scripts {
            <script data-no-instant defer type="module" src={ scriptPath }></script>
        }
        <!-- Dynamic CSS -->
        @templ.JSONScript("head-css", props.CSS)
        for _, cssPath := range props.CSS {
            <link rel="stylesheet" href={ cssPath } />
        }
        <!-- Dynamic CSS END -->
        <link rel="stylesheet" href="/_/embed-assets/css/fa/all.min.css">
        <style>[x-cloak]{ display: none !important; }</style>
        if props.AppendToHead != nil {
            <!-- AppendToHead -->
            @props.AppendToHead
            <!-- /AppendToHead -->
        }
        <noscript><style>.nojs-hidden{display: none;};</style></noscript>
        @ServerData()
    </head>
    {{
        bodyClasses := "m-0 font-text bg-background text-foreground min-h-screen"
    }}
    <body 
        if props.BodyAttributes != nil {
            { props.BodyAttributes... }
        }
        class={bodyClasses}>
        { children... }
        if props.InstantClick {
            <!-- Instant click -->
            <script src="/_/embed-assets/instantclick.min.js" data-no-instant></script>
            <script data-no-instant>InstantClick.init('mousedown');</script>
            <!-- Instant click END -->
        }
    </body>
    </html>
}
